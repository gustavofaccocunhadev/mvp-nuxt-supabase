{
  "name": "mvp-nuxt-supabase",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:types": "dotenv -e .env -- cmd /c \"mkdir app\\types 2>nul & npx supabase gen types typescript --project-id %SUPABASE_PROJECT_ID% > app/types/database.types.ts\"",
    "prepare": "npx skilld prepare || true"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.15.1",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.4.0",
    "@nuxtjs/seo": "^5.1.3",
    "@nuxtjs/supabase": "^2.0.4",
    "@tailwindcss/typography": "^0.5.19",
    "@takumi-rs/core": "^1.7.0",
    "nuxt": "^4.3.1",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.101",
    "dotenv-cli": "^11.0.0",
    "supabase": "^2.84.6"
  }
}
